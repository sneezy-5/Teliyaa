{
  "name": "teliyaa",
  "version": "0.2.0",
  "private": true,
  "description": "Teliyaa : l'annuaire des alias PI-SPI pour envoyer vite de l'argent à ses proches dans l'UEMOA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "vue-tsc --noEmit && vite build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "icons": "capacitor-assets generate --android --ios --iconBackgroundColor '#4338CA' --iconBackgroundColorDark '#4338CA' --splashBackgroundColor '#4338CA' --splashBackgroundColorDark '#4338CA'"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capgo/capacitor-native-biometric": "^8.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
