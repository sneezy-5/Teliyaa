# L'app utilise toujours ton serveur (dossier server/).
# VITE_FORCE_DEMO=1 seulement pour une démo sans serveur (tout dans le navigateur, code = 123456).
VITE_FORCE_DEMO=
# Adresse de ton serveur. Vide = même adresse que le site (dev : le proxy Vite renvoie /api vers localhost:3000).
# OBLIGATOIRE pour l'app mobile : VITE_API_URL=https://teliyaa.com
VITE_API_URL=

# Adresse publique utilisée dans les liens partagés (ex. https://teliyaa.com).
# Vide = l'adresse actuelle du site.
VITE_PUBLIC_URL=

# "hash" pour un hébergement statique sans réécriture d'URL (liens en /#/u/pseudo).
VITE_ROUTER=
