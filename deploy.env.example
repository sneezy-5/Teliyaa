# =====================================================================
# Configuration du serveur Teliyaa.
# Copie ce fichier en « deploy.env » SUR TON SERVEUR et remplis-le.
# Ne partage jamais deploy.env (mots de passe et clé d'API) et ne le mets pas sur GitHub.
# =====================================================================

# Ton PostgreSQL existant, via PgBouncer sur le réseau « whatsapp-network ».
# Base et utilisateur à créer une fois : voir deploy/create-db.sql
# PgBouncer doit connaître la base « teliyaa » et l'utilisateur « teliyaa » (voir README).
DATABASE_URL=postgres://root:password@infra_pgbouncer:6432/teliyaa

# Secret de l'app, 32 caractères minimum (openssl rand -hex 32)
APP_SECRET=
# Envoi du code de connexion : whatsapp | console (code écrit dans les logs, pour tester)
OTP_DRIVER=whatsapp
WHATSAPP_API_URL=https://api.poolchat.online/api/messages/send
WHATSAPP_API_KEY=

# Compte de test pour la vérification Play Store / App Store (laisser vide sinon).
# Pour ce numéro, aucun message n'est envoyé : seul ce code à 6 chiffres est accepté.
REVIEW_PHONE=
REVIEW_CODE=

# Nginx est devant l'app : on lit l'IP du visiteur dans X-Forwarded-For
TRUST_PROXY=1

# Adresses autorisées à appeler l'API depuis l'app mobile (Capacitor) — ne pas changer sans raison
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost
